//go:build !stub
// +build !stub

package service

import (
	"{{.Module}}/config"
	"{{.Module}}/internal/port"
)

// New{{.Entity}}Service is the composition-root entry point for constructing
// the {{.EntityLower}} service. Under default builds (no `-tags=stub`) this
// returns the production service; cfg.ServiceBackend is ignored because the
// stub backend is not linked into the binary.
//
// The factory shape exists so cmd/{{.Name}}/main.go can call one function
// regardless of build tag — the stub-tagged variant of this file (in
// factory_stub.go) switches on cfg.ServiceBackend to choose between the
// real service and the stub.
func New{{.Entity}}Service(cfg config.Config, repo port.{{.Entity}}Repository) port.{{.Entity}}Service {
	_ = cfg // honored only by the stub-tagged build
	return New(repo)
}

// UsesStubBackend reports whether the composition root should skip opening a
// database, cache and broker. Always false here: the stub package is not linked
// into a default build, so there is nothing to route to and storage is always
// required.
//
// This is deliberately a build-tagged pair rather than a plain check on
// cfg.ServiceBackend. SERVICE_BACKEND=stub is the default in a fresh .env, so
// an env-only test would make a production binary skip its database whenever
// that value survived into the deployment — turning a stale config line into an
// outage instead of a loud startup failure.
func UsesStubBackend(cfg config.Config) bool {
	_ = cfg // the stub-tagged build consults it
	return false
}
